{
  "name": "squash-tm-mcp-agent",
  "version": "1.0.0",
  "description": "MCP agent for Squash TM test management - create, update, and sync test cases",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "sync": "tsx scripts/syncSquashTM.ts",
    "transmit": "tsx scripts/transmitTestCase.ts",
    "automated": "tsx scripts/markAutomated.ts",
    "get-project": "tsx scripts/getProject.ts",
    "get-all-projects": "tsx scripts/getAllProjects.ts",
    "test:iteration": "tsx scripts/runIterationTests.ts"
  },
  "keywords": [
    "mcp",
    "squash-tm",
    "test-management",
    "automation",
    "gherkin",
    "bdd"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.9.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "dotenv": "^16.4.5"
  }
}
